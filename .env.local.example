# Copy this file to .env.local and fill in your values.

# --- Supabase ---
# Project URL + anon key from Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only — never expose to the client).
# Used for admin access: file previews, email lookups, webhook updates.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of the deployed app. Used to build client portal links.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) ---
# Resend API key + from address for change-request/approval notifications.
# Email sending is skipped entirely when RESEND_API_KEY is unset.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Portalize <onboarding@resend.dev>

# --- Payment webhook (optional) ---
# Shared secret guarding POST /api/webhooks/payment. The webhook sets a
# project's payment_status to 'paid'. Generate any random string.
WEBHOOK_SECRET=generate-a-long-random-secret
